      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first()?.json;\nlet body=raw?.body??raw;\nif(typeof body==='string'){try{body=JSON.parse(body);}catch{body=null;}}\nconst error=mensaje=>[{json:{ok:false,httpStatus:400,tipo:'error_solicitud',mensaje}}];\nif(!body || typeof body!=='object' || Array.isArray(body)) return error('En Body seleccione raw -> JSON y envie cliente, monto y fechaEmision');\nif(body.facturaId!==undefined && body.facturaId!==null){\n  const id=body.facturaId;\n  const valido=(typeof id==='number' && Number.isSafeInteger(id)&&id>0)||\n   (typeof id==='string' && /^[1-9][0-9]*$/.test(id) && Number.isSafeInteger(Number(id)));\n  if(!valido) return error('facturaId debe ser entero positivo, o envie cliente, monto y fechaEmision sin ID');\n  return [{json:{ok:true,modo:'existente',facturaId:String(id)}}];\n}\nconst f=(body.factura&&typeof body.factura==='object'&&!Array.isArray(body.factura))?body.factura:body;\nif(typeof f.cliente!=='string'||f.cliente.trim().length<2||f.cliente.trim().length>120) return error('cliente debe contener entre 2 y 120 caracteres');\nif(typeof f.monto!=='number'||!Number.isFinite(f.monto)||f.monto<=0) return error('monto debe ser un numero positivo, sin comillas');\nif(f.moneda!==undefined&&!['CRC','USD'].includes(f.moneda)) return error('moneda debe ser CRC o USD');\nconst iso=f.fechaEmision;\nif(typeof iso!=='string'||!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(iso)) return error('fechaEmision debe tener formato YYYY-MM-DD');\nconst [a,m,d]=iso.split('-').map(Number); const fecha=new Date(Date.UTC(a,m-1,d));\nif(fecha.getUTCFullYear()!==a||fecha.getUTCMonth()!==m-1||fecha.getUTCDate()!==d) return error('fechaEmision es una fecha imposible');\nconst facturaNueva={cliente:f.cliente.trim(),monto:f.monto,moneda:f.moneda??'CRC',fechaEmision:iso,fechaVencimiento:null,estado:'pendiente'};\nreturn [{json:{ok:true,modo:'nueva',facturaNueva}}];"
      },
