        "jsCode": "const r=$input.first()?.json;\nconst c=$('Validar factura en JSON Server').first().json;\nif(!r||r.statusCode!==200||!Array.isArray(r.body)||!r.body.length||\n  r.body.some(h=>!h||typeof h.date!=='string'||!h.date.startsWith(String(c.anioInicial)+'-'))){\n return [{json:{ok:false,httpStatus:502,tipo:'error_feriados',facturaId:c.facturaId,\n mensaje:'No se pudieron validar feriados del anio de emision. Sin PATCH'}}];\n}\nreturn [{json:{...c,feriadosIniciales:r.body}}];"
