      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first()?.json;\nconst plan=$('POO - Calcular 15 dias habiles').first().json;\nif(!r||![200,201].includes(r.statusCode)||!r.body||\n String(r.body.id)!==String(plan.facturaId)||\n r.body.estado!==plan.actualizacion.estado||r.body.fechaVencimiento!==plan.actualizacion.fechaVencimiento){\n return [{json:{ok:false,httpStatus:502,tipo:'error_escritura',facturaId:plan.facturaId,\n mensaje:'JSON Server no confirmo el PATCH esperado'}}];\n}\nreturn [{json:{ok:true,httpStatus:200,tipo:'factura_procesada',facturaId:plan.facturaId,\n cliente:r.body.cliente,monto:r.body.monto,moneda:r.body.moneda,\n fechaEmision:r.body.fechaEmision,fechaVencimiento:r.body.fechaVencimiento,\n estado:r.body.estado,diasHabiles:plan.diasHabiles,modo:plan.modo,mensaje:plan.motivo}}];"
