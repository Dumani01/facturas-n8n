    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "__CODIGO_POO_GENERADO__\n// Estas clases se insertan desde src/ al generar el JSON del workflow.\nconst c=$('Validar respuesta feriados Nager').first().json;\nconst r=$input.first()?.json;\nif(!r||r.statusCode!==200||!Array.isArray(r.body)||!r.body.length||\n  r.body.some(h=>!h||typeof h.date!=='string'||!h.date.startsWith(String(c.anioSiguiente)+'-'))){\n return [{json:{ok:false,httpStatus:502,tipo:'error_feriados',facturaId:c.facturaId,\n mensaje:'No se pudieron validar feriados del anio siguiente. Sin PATCH'}}];\n}\ntry {\n const calendario=new CalendarioLaboral([...c.feriadosIniciales,...r.body],[c.anioInicial,c.anioSiguiente]);\n const factura=new Factura(c.factura);\n const plan=factura.planificarActualizacion(calendario,c.hoy,c.diasHabiles);\n return [{json:{ok:true,httpStatus:200,facturaId:c.facturaId,\n  cliente:c.factura.cliente,monto:c.factura.monto,moneda:c.factura.moneda,\n  fechaEmision:c.factura.fechaEmision,fechaConsulta:c.hoy,diasHabiles:c.diasHabiles,modo:c.modo,\n  ...plan}}];\n}catch(err){\n return [{json:{ok:false,httpStatus:422,tipo:'error_datos_factura',facturaId:c.facturaId,\n  mensaje:String(err.message)}}];\n}"
      },
