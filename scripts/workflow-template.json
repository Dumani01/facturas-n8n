    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first()?.json;\nconst req=$('Validar solicitud - ID opcional').first().json;\nconst esperado=req.modo==='nueva'?201:200;\nif(!r||r.statusCode!==esperado||!r.body||typeof r.body!=='object'||Array.isArray(r.body)){\n return [{json:{ok:false,httpStatus:r?.statusCode===404?404:502,\n  tipo:r?.statusCode===404?'factura_no_existe':'error_json_server',\n  mensaje:r?.statusCode===404?'La factura no existe en JSON Server':'JSON Server no confirmo la factura'}}];\n}\nconst factura=r.body;\nif((typeof factura.id!=='number' && typeof factura.id!=='string')||!String(factura.id).trim()){\n return [{json:{ok:false,httpStatus:502,tipo:'error_json_server',mensaje:'JSON Server no asigno ID'}}];\n}\nconst partes=new Intl.DateTimeFormat('en-US',{timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());\nconst v=k=>partes.find(p=>p.type===k).value;\nconst hoy=`${v('year')}-${v('month')}-${v('day')}`;\nconst anio=Number(String(factura.fechaEmision??'').slice(0,4));\nif(!Number.isInteger(anio)||anio<1900||anio>2100) return [{json:{ok:false,httpStatus:422,\n tipo:'factura_invalida',facturaId:factura.id,mensaje:'La fecha de emision guardada es invalida'}}];\nreturn [{json:{ok:true,modo:req.modo,facturaId:String(factura.id),factura,hoy,\n anioInicial:anio,anioSiguiente:anio+1,diasHabiles:15}}];"
      },
